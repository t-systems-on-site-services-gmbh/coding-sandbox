# Persoenliche Einstellungen. Kopie als .env anlegen (macht ./sandbox.sh beim
# ersten Aufruf automatisch). Die .env gehoert nicht ins Git.

# ---------------------------------------------------------------- Projekte
# Nur dieses Verzeichnis sieht der Container (unter /work).
# Unter WSL2 unbedingt ein Linux-Pfad (~/...), nicht /mnt/c/...
WORKSPACE_DIR=./workspace

# Was ein blankes ./sandbox.sh startet: shell | codex | opencode
DEFAULT_ENTRY=shell

# ---------------------------------------------------------------- Firmennetz
# Leer lassen, wenn kein Proxy noetig ist. Gilt fuer Build und Laufzeit.
# Beispiel: HTTP_PROXY=http://proxy.example.com:8080
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
# Firmen-Stammzertifikate (TLS-Inspektion): *.crt/*.pem nach certs/ legen,
# danach ./sandbox.sh rebuild. Siehe README.

# ---------------------------------------------------------------- Git
# Leer = Name und E-Mail aus der Git-Konfiguration des Hosts
GIT_USER_NAME=
GIT_USER_EMAIL=

# ---------------------------------------------------------------- Agenten
# Versionen: "latest" oder fest, z. B. 0.163.0 bzw. 1.18.30-aie
CODEX_VERSION=latest
AIE_OPENCODE_VERSION=latest
# opencode: AIE-Konfiguration beim ersten Start automatisch holen (1/0)
AIE_AUTO_LOGIN=1

# ---------------------------------------------------------------- Container
SANDBOX_CPUS=4
SANDBOX_MEMORY=8g
# sudo ohne Passwort im Container (true/false). Betrifft nur den Container.
ENABLE_SUDO=false
# GitHub CLI mitinstallieren
INSTALL_GH=true
# Weitere Debian-Pakete, leerzeichengetrennt (danach ./sandbox.sh rebuild)
EXTRA_APT_PACKAGES=
# Vorlagen aus config/ bei jedem Start ueberschreiben (1) oder nur einmal (0)
SEED_OVERWRITE=0
TZ=Europe/Berlin
